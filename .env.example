# Copier en .env (non versionné) et remplir

# RAG — index ChromaDB (défaut data/chroma)
CHROMA_PATH=data/chroma

# LLM local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT=180

# Alertes email (Gmail : utiliser un mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=

# Alertes Slack (optionnel)
SLACK_WEBHOOK_URL=

# Routes /api/admin/* (sync, reindex, status) : en-tête X-Admin-Token. Vide = routes désactivées.
ADMIN_TOKEN=

# Comptes utilisateurs
# Clé maîtresse de chiffrement (obligatoire en production, longue et aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(48))")
# La changer rend illisibles les données déjà chiffrées.
APP_SECRET_KEY=
APP_DB_PATH=data/app.db
SESSION_TTL_HOURS=168
# Base des liens envoyés par email (vérification, mot de passe oublié)
FRONTEND_URL=http://localhost:5173
# dev uniquement : sans SMTP, l'API renvoie le lien de vérification (champ dev_lien)
# pour tester sans boîte mail. À NE PAS définir en production.
APP_ENV=
